# Lets band3 read Rock Band instruments through their USB dongles (the
# hid_instruments setting) as the logged-in user. Install with:
#   sudo cp 70-band3-rock-band-instruments.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# then replug the dongles. The ids match src/Input/hid_instrument_types.cpp.

# PS3: guitar, drums, MIDI Pro Adapter (drums)
KERNEL=="hidraw*", ATTRS{idVendor}=="12ba", ATTRS{idProduct}=="0200|0210|0218", TAG+="uaccess"
# Wii: guitars (RB1, RB2+), drums (RB1, RB2+), MIDI Pro Adapter (drums)
KERNEL=="hidraw*", ATTRS{idVendor}=="1bad", ATTRS{idProduct}=="0004|3010|0005|3110|3138", TAG+="uaccess"
# PS4 MadCatz Stratocaster and drums
KERNEL=="hidraw*", ATTRS{idVendor}=="0738", ATTRS{idProduct}=="8261|8262", TAG+="uaccess"
# PS4 PDP Jaguar and drums, PDP Riffmaster (PS4 and PS5 modes)
KERNEL=="hidraw*", ATTRS{idVendor}=="0e6f", ATTRS{idProduct}=="0173|0174|024a|0249", TAG+="uaccess"
# CRKD Gibson SG (PS4 and PS5 modes, wired and dongle)
KERNEL=="hidraw*", ATTRS{idVendor}=="3651", ATTRS{idProduct}=="1500|5500|1600|5600", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="3958", ATTRS{idProduct}=="5500|5600", TAG+="uaccess"
