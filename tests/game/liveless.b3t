# Takes a fresh profile online with Liveless and finds Xbox Live players, for
# two band3s on this PC to play together: run it on the host first, then on the
# joiner, and the joiner joins the host's band. The host's game needs no
# address to join (it searches, finds itself, and waits for players); the
# joiner's is the host's, and plays on another port.
#   python tools/band3ctl.py --port 21181 launch --fresh -- --liveless=true --username=host
#   python tools/band3ctl.py --port 21181 run tests/game/liveless.b3t
#   python tools/band3ctl.py --port 21182 launch --fresh --user-data out/test_user_data_b -- --liveless=true --username=joiner --liveless_port=9203 --liveless_connect=127.0.0.1:9103
#   python tools/band3ctl.py --port 21182 run tests/game/liveless.b3t
# Then each shows the other in its band: the host picks Play With Current
# Lineup (green) and both go to the setlist together.

wait screen=splash_screen timeout=120s
press start until screen=first_time_calibration timeout=30s
press down
press green until screen=dx_welcome_screen timeout=30s
sleep 2s
press green until screen=hint_rb3_welcome_screen timeout=30s
sleep 2s
press green until screen=manage_band_screen timeout=30s
sleep 2s
press red until screen=main_hub_screen timeout=30s
sleep 2s
# the overshell: Play on Xbox Live
press start
sleep 2s
press down
sleep 1s
press green
sleep 4s
# back out of it: Return
press up
sleep 1s
press green
sleep 2s
# Play Now, Quickplay, Find Xbox Live Players
press green
sleep 3s
press green
sleep 4s
press down
sleep 1s
press down
sleep 1s
press green
sleep 10s
screenshot liveless-finding
