# Two players play a song together on autoplay: guitar and bass.
# Starts on the main menu (main_hub_screen), with player 1 joined.
# This crashed band3 while the song loaded until XNetRandom gave real random
# bytes (src/Hooks/xnet_random.cpp): every player had player 1's user guid.

p2 instrument guitar
sleep 1s
p2 press start
sleep 1500ms
set autoplay true
# Play Now, Quickplay, Choose Songs
press green
sleep 1s
press green
sleep 1s
press green until screen=song_select_screen timeout=30s
sleep 1s
# past the 123 heading to 20th Century Boy
press down
press down
sleep 500ms
press green until screen=part_difficulty_screen timeout=30s
sleep 1500ms
# player 1: Guitar, Expert
press green
sleep 500ms
press green
sleep 1s
# player 2: Bass (offered first, as player 1 has guitar), its default difficulty.
# Player 2 isn't signed in, so joined as a guest: skip_profile_prompt (on by
# default) answers RB3's Choose Profile with No Profile. With the prompt up,
# the first press here would answer it and the song wouldn't start.
p2 press green
sleep 1s
p2 press green
wait in_game timeout=60s
expect song=20thcenturyboy
wait frames=600 timeout=60s
screenshot multiplayer-song
