# Two players play a song on autoplay, guitar and drums, pairing the game's
# frame with the native view's (`capture screen-mp2-<kind>`) on the screens two
# players bring: the part and difficulty choice with both players' panels, the
# song with two tracks at points through it, its pause menu and the results.
# Starts where boot.b3t leaves Rock Band 3 Deluxe (on a fresh profile):
#   python tools/band3ctl.py launch --fresh -- --renderer=emulated --native_view_record_targets=true --test_random_seed=21 --async_shader_compilation=false
#   python tools/band3ctl.py run tests/game/boot.b3t
#   python tools/band3ctl.py run tests/game/render_multiplayer.b3t
# Every frame draws everything here, as in render_song.b3t, in the same venue.
# render_multiplayer4.b3t is the same with four players.

# the welcome hint, whose first choice customizes the band; back out of that
# to the main menu
wait screen=hint_rb3_welcome_screen timeout=30s
wait frames=60
press green
wait screen=manage_band_screen timeout=30s
wait frames=60
press red
wait screen=main_hub_screen timeout=30s
wait frames=60
set autoplay true
set forced_venue arena_04
set disable_even_odd_rendering true
set song_speed 1
# player 2 joins on drums, as a guest (skip_profile_prompt answers RB3's
# Choose Profile with No Profile)
p2 instrument drums
wait frames=60
p2 press start
wait frames=120
# Play Now, Quickplay, Choose Songs
press green
wait frames=90
press green
wait frames=90
press green
wait screen=song_select_screen timeout=30s
wait frames=60
# past the 123 heading to 20th Century Boy
press down
press down
wait frames=30
press green
wait screen=part_difficulty_screen timeout=30s
wait frames=90
capture screen-mp2-part
# player 1: Guitar, Expert; player 2 (drums press A for green): Drums, its
# default difficulty
press green
wait frames=30
press green
wait frames=60
p2 press a
wait frames=60
p2 press a
wait in_game timeout=60s
expect song=20thcenturyboy
wait frames=600 timeout=60s
capture screen-mp2-10s
wait frames=900 timeout=60s
capture screen-mp2-25s
wait frames=900 timeout=60s
capture screen-mp2-40s
# the pause menu, an overlay on the same screen, and on again
press start
wait frames=30
capture screen-mp2-pause
press green
wait frames=120
# the results
wait screen=coop_endgame_screen timeout=300s
wait frames=120
capture screen-mp2-results
