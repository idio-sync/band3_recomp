# render_song.b3t with RB3's even/odd rendering left on (it emulates 30 fps:
# a frame draws the world, the next post-processes it and presents it with
# its own overlay), pairing the game's frame with the native view's at the
# same points through the song, for render checks:
#   out/native_view_replay.exe screenshots/<name>.cap side.png --compare screenshots/<name>.png
# Starts where boot.b3t leaves Rock Band 3 Deluxe (on a fresh profile). Launch
# on the emulated GPU, whose picture is the reference (render_song.b3t says
# why), with the passes RB3 draws into textures recorded from the start
# (outfits are composed once, in the main menu), and without full readback:
# the native view draws those passes itself.
#   python tools/band3ctl.py launch --fresh -- --renderer=emulated --native_view_record_targets=true
# Add --async_shader_compilation=false to the launch: with asynchronous
# compilation the emulated GPU skips draws whose shaders aren't ready, and the
# outfits RB3 composes once in the main menu can stay black in the game's picture.
# A fresh profile's band is random; add --test_random_seed=<n> to the launch
# for the same band every run (the poses and camera angles still vary a
# little). With 21, Futurama's Fry, a cel-shaded Deluxe character, plays
# guitar: he is in render-song-eo-25s.
# Each capture's reply says proc_cmds 2 and composed true, with the world
# frame it has (world_frame, the game frame before its own); `composed` makes
# the capture fail if it isn't (it fell back to another frame: held_fallback).
# Each capture is followed by `screenshot <name>-again`, the window's picture
# a command later: render_song.b3t says why.

# the welcome hint, whose first choice customizes the
# band; back out of that to the main menu
wait screen=hint_rb3_welcome_screen timeout=30s
sleep 1s
press green until screen=manage_band_screen timeout=30s
sleep 1s
press red until screen=main_hub_screen timeout=30s
sleep 1s
set autoplay true
# the same venue every run, so captures compare across runs
set forced_venue arena_04
# even/odd rendering stays on, as the game ships: frames draw the world and
# post-process it by turns, and each capture is a post frame's with the world
# frame's before it (src/Render/frame_compose.h), as the game presents it
set disable_even_odd_rendering false
# Play Now, Quickplay, Choose Songs
press green
sleep 1s
press green
sleep 1s
press green until screen=song_select_screen timeout=30s
sleep 1s
# past the 123 heading to 20th Century Boy
press down
press down
sleep 500ms
press green until screen=part_difficulty_screen timeout=30s
sleep 1500ms
# Guitar, Expert
press green
sleep 500ms
press green
wait in_game timeout=60s
expect song=20thcenturyboy
capture render-song-eo-start composed
screenshot render-song-eo-start-again
wait frames=600 timeout=60s
capture render-song-eo-10s composed
screenshot render-song-eo-10s-again
wait frames=900 timeout=60s
capture render-song-eo-25s composed
screenshot render-song-eo-25s-again
wait frames=900 timeout=60s
capture render-song-eo-40s composed
screenshot render-song-eo-40s-again
