# Plays a song on autoplay and pairs the game's frame with the native view's at
# points through it, for render checks:
#   out/native_view_replay.exe screenshots/<name>.cap side.png --compare screenshots/<name>.png
# Starts where boot.b3t leaves Rock Band 3 Deluxe (on a fresh profile). Launch
# on the emulated GPU, whose picture is the reference (the native renderer is
# the default on Windows: under it `capture` has the emulated GPU draw whole
# frames first, so the pairs hold, but guest memory's copies below are stale),
# with the passes RB3 draws into textures recorded from the start (outfits are
# composed once, in the main menu), which the native view draws itself:
#   python tools/band3ctl.py launch --fresh -- --renderer=emulated --native_view_record_targets=true
# With full readback too, guest memory's copies of those textures (garbage
# without it) are there to compare against (replay's --rt-guest):
#   python tools/band3ctl.py launch --fresh -- --renderer=emulated --native_view_record_targets=true --readback_resolve=full
# Add --async_shader_compilation=false to the launch: with asynchronous
# compilation the emulated GPU skips draws whose shaders aren't ready, and the
# outfits RB3 composes once in the main menu can stay black in the game's picture.
# A fresh profile's band is random; add --test_random_seed=<n> to the launch
# for the same band every run (the poses and camera angles still vary a
# little). With 21, Futurama's Fry, a cel-shaded Deluxe character, plays
# guitar: he is in render-song-25s.
# Each capture is followed by `screenshot <name>-again`, the window's picture
# a command later (the emulated GPU's under these launches, the native
# renderer's with --emulated_gpu=off): what moved by itself meanwhile, which
# tools/pairs.py --cross leaves out when it sets a run without the emulated
# GPU against this one (docs/native-renderer.md, Render checks).

# the welcome hint, whose first choice customizes the
# band; back out of that to the main menu
wait screen=hint_rb3_welcome_screen timeout=30s
sleep 1s
press green until screen=manage_band_screen timeout=30s
sleep 1s
press red until screen=main_hub_screen timeout=30s
sleep 1s
set autoplay true
# the same venue every run, so captures compare across runs
set forced_venue arena_04
# every frame draws everything, the world and its post-processing alike
# (render_song_evenodd.b3t checks the game as it ships, which draws them by
# turns)
set disable_even_odd_rendering true
# Play Now, Quickplay, Choose Songs
press green
sleep 1s
press green
sleep 1s
press green until screen=song_select_screen timeout=30s
sleep 1s
# past the 123 heading to 20th Century Boy
press down
press down
sleep 500ms
press green until screen=part_difficulty_screen timeout=30s
sleep 1500ms
# Guitar, Expert
press green
sleep 500ms
press green
wait in_game timeout=60s
expect song=20thcenturyboy
capture render-song-start
screenshot render-song-start-again
wait frames=600 timeout=60s
capture render-song-10s
screenshot render-song-10s-again
wait frames=900 timeout=60s
capture render-song-25s
screenshot render-song-25s-again
wait frames=900 timeout=60s
capture render-song-40s
screenshot render-song-40s-again
