# Plays a song on autoplay and pairs the game's frame with the native view's at
# points through it, for render checks:
#   out/native_view_replay.exe screenshots/<name>.cap side.png --compare screenshots/<name>.png
# Starts where boot.b3t leaves Rock Band 3 Deluxe (on a fresh profile). Launch
# with the passes RB3 draws into textures recorded from the start (outfits are
# composed once, in the main menu), which the native view draws itself:
#   python tools/band3ctl.py launch --fresh -- --native_view_record_targets=true
# With full readback too, guest memory's copies of those textures (garbage
# without it) are there to compare against (replay's --rt-guest):
#   python tools/band3ctl.py launch --fresh -- --native_view_record_targets=true --readback_resolve=full
# A fresh profile's band is random; add --test_random_seed=<n> to the launch
# for the same band every run (the poses and camera angles still vary a
# little). With 21, Futurama's Fry, a cel-shaded Deluxe character, plays
# guitar: he is in render-song-25s.

# Deluxe can't save its settings to band3's read-only game folder: I Understand
wait screen=dx_settings_error_screen timeout=30s
wait frames=60
press green
# back to the welcome hint underneath it, whose first choice customizes the
# band; back out of that to the main menu
wait screen=hint_rb3_welcome_screen timeout=30s
wait frames=60
press green
wait screen=manage_band_screen timeout=30s
wait frames=60
press red
wait screen=main_hub_screen timeout=30s
wait frames=60
set autoplay true
# the same venue every run, so captures compare across runs
set forced_venue arena_04
# every frame draws everything, the world and its post-processing alike
# (render_song_evenodd.b3t checks the game as it ships, which draws them by
# turns)
set disable_even_odd_rendering true
# Play Now, Quickplay, Choose Songs
press green
wait frames=60
press green
wait frames=60
press green
wait screen=song_select_screen timeout=30s
wait frames=60
# past the 123 heading to 20th Century Boy
press down
press down
wait frames=30
press green
wait screen=part_difficulty_screen timeout=30s
wait frames=90
# Guitar, Expert
press green
wait frames=30
press green
wait in_game timeout=60s
expect song=20thcenturyboy
capture render-song-start
wait frames=600 timeout=60s
capture render-song-10s
wait frames=900 timeout=60s
capture render-song-25s
wait frames=900 timeout=60s
capture render-song-40s
