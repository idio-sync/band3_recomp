# Checks that band3 connects to a Liveless Rooms server again by itself after
# the server drops it: against the mock on this PC, never the public server.
# The mock hangs up on the first login 3 s in, and hands out a new code to the
# connection after it. The mock first:
#   python tools/liveless_rooms_mock.py --address 127.0.0.1 --port 19533 --ping 2 --drop-after-login 3 --drop-count 1 --codes HOST0001,HOST0002
#   python tools/band3ctl.py --port 21183 launch --fresh -- --liveless=true --liveless_rooms=true --liveless_rooms_server=127.0.0.1:19533 --username=host
#   python tools/band3ctl.py --port 21183 run tests/game/liveless_rooms_reconnect.b3t
# The mock's log then has `close #1 ("host"): dropped (--drop-after-login)` and
# a second login with HOST0002; band3's, "rooms: connecting again in 5 s
# (attempt 2)". No game is needed: it all happens while the game boots.

wait rooms=logged_in timeout=20s
rooms_status state=logged_in code=HOST0001 attempt=1 retry_in=0
wait rooms=disconnected timeout=15s
# the state stays disconnected while it waits, and says how long for
rooms_status state=disconnected error~closed retry_in!=0 attempt=1
wait rooms=logged_in timeout=20s
rooms_status state=logged_in code=HOST0002 attempt=2 retry_in=0 error=
