# Goes through the screens render_screens_menus.b3t and render_screens_song.b3t
# don't, that work offline, pairing the game's frame with the native view's
# (`capture screen-<kind>`) on each: the character creator and its face maker
# (before and after Randomize, which reblends the face) and its leave dialog,
# the career's goals, Rock Band 3 Deluxe's Play a Show and its setlist
# browser, a setlist being made, the calibration screens, and on drums the
# instrument trainers, a drum lesson's preview and the drum trainer. Not the
# store or online rankings: they need the network. Starts where boot.b3t
# leaves Rock Band 3 Deluxe (on a fresh profile; the hints and goal screens
# below are a first time's):
#   python tools/band3ctl.py launch --fresh -- --renderer=emulated --native_view_record_targets=true --test_random_seed=21 --async_shader_compilation=false
#   python tools/band3ctl.py run tests/game/boot.b3t
#   python tools/band3ctl.py run tests/game/render_screens_more.b3t
# Even/odd rendering stays on, as the game ships, as in
# render_screens_menus.b3t. The main menu's cursor goes back to Play Now
# each time it comes back to it. Each capture is followed by
# `screenshot <name>-again`, the window's picture a command later, as
# render_screens_boot.b3t says why.

# the welcome hint: Continue, to the main menu
wait screen=hint_rb3_welcome_screen timeout=30s
sleep 1s
press down
sleep 333ms
press green until screen=main_hub_screen timeout=30s
sleep 2s

# ---- the character creator ----
# Customize, Create Character: the camera comes in through the barbershop's
# doors first, for about 10 s
press down
sleep 333ms
press down
sleep 333ms
press down
sleep 500ms
press green
sleep 1s
press down
sleep 333ms
press down
sleep 500ms
press green until screen=charactercreator_screen timeout=60s
wait frames=900
capture screen-creator
screenshot screen-creator-again
# Modify Head, Customize Face: the face maker, close on the face
press down
sleep 333ms
press down
sleep 333ms
press down
sleep 500ms
press green
sleep 2s
press green
sleep 3s
capture screen-face-maker
screenshot screen-face-maker-again
# Randomize: RB3 blends the new face's textures (RndTexBlender)
press green
sleep 3s
capture screen-face-random
screenshot screen-face-random-again
# back out to the creator's own menu, and once more for its leave dialog
press red
sleep 1s
press red
sleep 1s
press red until screen=charactercreator_leave_screen timeout=30s
sleep 1s
capture screen-creator-leave
screenshot screen-creator-leave-again
# Yes, leave
press up
sleep 333ms
press green until screen=main_hub_screen timeout=60s
sleep 2s

# ---- the career's goals ----
# Career, My Goals: a vignette, the career's hint the first time, then the goals
press down
sleep 500ms
press green
sleep 1s
press green until screen=hint_career_screen timeout=60s
sleep 1s
press green until screen=accomplishment_screen timeout=30s
sleep 2s
capture screen-goals
screenshot screen-goals-again
press red until screen=main_hub_screen timeout=60s
sleep 2s

# ---- Play a Show and setlists ----
# Play a Show: Rock Band 3 Deluxe's introduction to it, then its music library
press down
sleep 333ms
press down
sleep 333ms
press down
sleep 333ms
press down
sleep 500ms
press green until screen=dx_playashow_intro_screen timeout=30s
sleep 1500ms
capture screen-play-a-show
screenshot screen-play-a-show-again
press green until screen=song_select_screen timeout=30s
sleep 1500ms
# from Random Song up to Setlists / Battles: the setlist browser
press up
sleep 333ms
press up
sleep 500ms
press green
sleep 2s
capture screen-setlist-browser
screenshot screen-setlist-browser-again
# Make a Setlist: 20th Century Boy and 25 or 6 to 4, past Finish Setlist and
# the 123 heading
press green
sleep 2s
press down
sleep 333ms
press down
sleep 333ms
press down
sleep 500ms
press green
sleep 1s
press down
sleep 500ms
press green
sleep 2s
capture screen-setlist
screenshot screen-setlist-again
# back, without the setlist, to the main menu
press red until screen=main_hub_screen timeout=60s
sleep 2s

# ---- calibration ----
# the menu (Start): Options, System Settings, Calibration, Calibration, Yes
press start
sleep 1s
press down
sleep 250ms
press down
sleep 250ms
press down
sleep 333ms
press green
sleep 1s
press down
sleep 250ms
press down
sleep 250ms
press down
sleep 333ms
press green
sleep 1s
press down
sleep 250ms
press down
sleep 250ms
press down
sleep 333ms
press green
sleep 1s
press down
sleep 250ms
press down
sleep 333ms
press green
sleep 1s
press green until screen=cal_welcome_screen timeout=30s
sleep 1500ms
capture screen-cal-welcome
screenshot screen-cal-welcome-again
# Calibrate Automatically, which a guitar offers first: its audio step, then
# back, as the virtual guitar has no light or audio sensor
press green until screen=cal_hw_audio_screen timeout=30s
sleep 1s
capture screen-cal-auto
screenshot screen-cal-auto-again
press red until screen=cal_welcome_screen timeout=30s
sleep 1s
# Calibrate Manually: audio first
press right
sleep 500ms
press green until screen=cal_audio_screen timeout=30s
sleep 1s
capture screen-cal-audio
screenshot screen-cal-audio-again
# its test, which nothing hits, fails; Enter Calibration Numbers, Continue
press green until screen=cal_manual_failed_screen timeout=90s
sleep 1s
press down
sleep 333ms
press green until screen=cal_manual_audio_postfailure_screen timeout=30s
sleep 1s
press green
# then video
wait screen=cal_visuals_screen timeout=30s
sleep 1s
capture screen-cal-video
screenshot screen-cal-video-again
press green until screen=cal_manual_failed_screen timeout=90s
sleep 1s
press down
sleep 333ms
press green until screen=cal_manual_video_postfailure_screen timeout=30s
sleep 1s
press green until screen=cal_manual_complete_screen timeout=30s
sleep 1s
press green
# calibrating is a fresh profile's first goal
wait screen=hint_goalcomplete_screen timeout=30s
sleep 1s
press green until screen=main_hub_screen timeout=60s
sleep 2s

# ---- the drum trainer ----
# player 1 on drums, joined again; the trainers need an instrument of theirs
instrument drums
sleep 1500ms
press start
sleep 2s
# Training, Learn an Instrument: a vignette, then the instrument trainers
press down
sleep 333ms
press down
sleep 500ms
press a
sleep 1s
press down
sleep 500ms
press a until screen=training_screen timeout=60s
sleep 2s
capture screen-trainers
screenshot screen-trainers-again
# Drums, Introduction to the Kit: its preview, then the lesson
press a
sleep 2s
press a until screen=gem_preview_screen timeout=60s
sleep 4s
capture screen-drum-preview
screenshot screen-drum-preview-again
press a until screen=drum_trainer_screen timeout=30s
wait frames=300
capture screen-drum-trainer
screenshot screen-drum-trainer-again
# its pause menu's Back to Trainer Menu, Yes, then back to the main menu
press start
sleep 667ms
press down
press down
press down
press down
sleep 333ms
press a
sleep 1s
press a until screen=training_screen timeout=60s
sleep 1s
press b
sleep 1500ms
press b until screen=main_hub_screen timeout=60s
sleep 1s
instrument guitar
sleep 1500ms
press start
sleep 2s
