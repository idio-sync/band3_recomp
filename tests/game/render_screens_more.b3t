# Goes through the screens render_screens_menus.b3t and render_screens_song.b3t
# don't, that work offline, pairing the game's frame with the native view's
# (`capture screen-<kind>`) on each: the character creator and its face maker
# (before and after Randomize, which reblends the face) and its leave dialog,
# the career's goals, Rock Band 3 Deluxe's Play a Show and its setlist
# browser, a setlist being made, the calibration screens, and on drums the
# instrument trainers, a drum lesson's preview and the drum trainer. Not the
# store or online rankings: they need the network. Starts where boot.b3t
# leaves Rock Band 3 Deluxe (on a fresh profile; the hints and goal screens
# below are a first time's):
#   python tools/band3ctl.py launch --fresh -- --native_view_record_targets=true --test_random_seed=21 --async_shader_compilation=false
#   python tools/band3ctl.py run tests/game/boot.b3t
#   python tools/band3ctl.py run tests/game/render_screens_more.b3t
# Even/odd rendering stays on, as the game ships, as in
# render_screens_menus.b3t. The main menu's cursor goes back to Play Now
# each time it comes back to it.

# the welcome hint: Continue, to the main menu
wait screen=hint_rb3_welcome_screen timeout=30s
wait frames=60
press down
wait frames=20
press green
wait screen=main_hub_screen timeout=30s
wait frames=120

# ---- the character creator ----
# Customize, Create Character: the camera comes in through the barbershop's
# doors first, for about 10 s
press down
wait frames=20
press down
wait frames=20
press down
wait frames=30
press green
wait frames=60
press down
wait frames=20
press down
wait frames=30
press green
wait screen=charactercreator_screen timeout=60s
wait frames=900
capture screen-creator
# Modify Head, Customize Face: the face maker, close on the face
press down
wait frames=20
press down
wait frames=20
press down
wait frames=30
press green
wait frames=120
press green
wait frames=180
capture screen-face-maker
# Randomize: RB3 blends the new face's textures (RndTexBlender)
press green
wait frames=180
capture screen-face-random
# back out to the creator's own menu, and once more for its leave dialog
press red
wait frames=60
press red
wait frames=60
press red
wait screen=charactercreator_leave_screen timeout=30s
wait frames=60
capture screen-creator-leave
# Yes, leave
press up
wait frames=20
press green
wait screen=main_hub_screen timeout=60s
wait frames=120

# ---- the career's goals ----
# Career, My Goals: a vignette, the career's hint the first time, then the goals
press down
wait frames=30
press green
wait frames=60
press green
wait screen=hint_career_screen timeout=60s
wait frames=60
press green
wait screen=accomplishment_screen timeout=30s
wait frames=120
capture screen-goals
press red
wait screen=main_hub_screen timeout=60s
wait frames=120

# ---- Play a Show and setlists ----
# Play a Show: Rock Band 3 Deluxe's introduction to it, then its music library
press down
wait frames=20
press down
wait frames=20
press down
wait frames=20
press down
wait frames=30
press green
wait screen=dx_playashow_intro_screen timeout=30s
wait frames=90
capture screen-play-a-show
press green
wait screen=song_select_screen timeout=30s
wait frames=90
# from Random Song up to Setlists / Battles: the setlist browser
press up
wait frames=20
press up
wait frames=30
press green
wait frames=120
capture screen-setlist-browser
# Make a Setlist: 20th Century Boy and 25 or 6 to 4, past Finish Setlist and
# the 123 heading
press green
wait frames=120
press down
wait frames=20
press down
wait frames=20
press down
wait frames=30
press green
wait frames=60
press down
wait frames=30
press green
wait frames=120
capture screen-setlist
# back, without the setlist, to the main menu
press red
wait screen=main_hub_screen timeout=60s
wait frames=120

# ---- calibration ----
# the menu (Start): Options, System Settings, Calibration, Calibration, Yes
press start
wait frames=60
press down
wait frames=15
press down
wait frames=15
press down
wait frames=20
press green
wait frames=60
press down
wait frames=15
press down
wait frames=15
press down
wait frames=20
press green
wait frames=60
press down
wait frames=15
press down
wait frames=15
press down
wait frames=20
press green
wait frames=60
press down
wait frames=15
press down
wait frames=20
press green
wait frames=60
press green
wait screen=cal_welcome_screen timeout=30s
wait frames=90
capture screen-cal-welcome
# Calibrate Automatically, which a guitar offers first: its audio step, then
# back, as the virtual guitar has no light or audio sensor
press green
wait screen=cal_hw_audio_screen timeout=30s
wait frames=60
capture screen-cal-auto
press red
wait screen=cal_welcome_screen timeout=30s
wait frames=60
# Calibrate Manually: audio first
press right
wait frames=30
press green
wait screen=cal_audio_screen timeout=30s
wait frames=60
capture screen-cal-audio
# its test, which nothing hits, fails; Enter Calibration Numbers, Continue
press green
wait screen=cal_manual_failed_screen timeout=90s
wait frames=60
press down
wait frames=20
press green
wait screen=cal_manual_audio_postfailure_screen timeout=30s
wait frames=60
press green
# then video
wait screen=cal_visuals_screen timeout=30s
wait frames=60
capture screen-cal-video
press green
wait screen=cal_manual_failed_screen timeout=90s
wait frames=60
press down
wait frames=20
press green
wait screen=cal_manual_video_postfailure_screen timeout=30s
wait frames=60
press green
wait screen=cal_manual_complete_screen timeout=30s
wait frames=60
press green
# calibrating is a fresh profile's first goal
wait screen=hint_goalcomplete_screen timeout=30s
wait frames=60
press green
wait screen=main_hub_screen timeout=60s
wait frames=120

# ---- the drum trainer ----
# player 1 on drums, joined again; the trainers need an instrument of theirs
instrument drums
wait frames=90
press start
wait frames=120
# Training, Learn an Instrument: a vignette, then the instrument trainers
press down
wait frames=20
press down
wait frames=30
press a
wait frames=60
press down
wait frames=30
press a
wait screen=training_screen timeout=60s
wait frames=120
capture screen-trainers
# Drums, Introduction to the Kit: its preview, then the lesson
press a
wait frames=120
press a
wait screen=gem_preview_screen timeout=60s
wait frames=240
capture screen-drum-preview
press a
wait screen=drum_trainer_screen timeout=30s
wait frames=300
capture screen-drum-trainer
# its pause menu's Back to Trainer Menu, Yes, then back to the main menu
press start
wait frames=40
press down
press down
press down
press down
wait frames=20
press a
wait frames=60
press a
wait screen=training_screen timeout=60s
wait frames=60
press b
wait frames=90
press b
wait screen=main_hub_screen timeout=60s
wait frames=60
instrument guitar
wait frames=90
press start
wait frames=120
