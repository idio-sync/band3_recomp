# Goes through the menus from where render_screens_boot.b3t leaves Rock Band 3
# Deluxe (the welcome hint, on a fresh profile), pairing the game's frame with
# the native view's (`capture screen-<kind>`) on each kind of screen: the band
# and character screens, the main menu, and practice mode from its song and
# section choice through a practice frame and its pause menu. It leaves the
# game on the main menu, with the music library's cursor on 20th Century Boy
# for render_screens_song.b3t. Launch as render_screens_boot.b3t says.

# the welcome hint's first choice customizes the band
wait frames=60
press green
wait screen=manage_band_screen timeout=30s
wait frames=90
capture screen-manage-band
press red
wait screen=main_hub_screen timeout=30s
wait frames=120
capture screen-main-hub

# Customize, then Customize Character: a vignette (tv11_a_screen) while the
# closet loads, then the closet with the band's first character
press down
wait frames=20
press down
wait frames=20
press down
wait frames=30
press green
wait frames=60
press down
wait frames=30
press green
wait screen=tv11_a_screen timeout=30s
wait frames=60
capture screen-vignette
wait screen=customize_clothing_screen timeout=60s
wait frames=120
capture screen-closet
press red
wait screen=main_hub_screen timeout=30s
wait frames=60

# Training, Practice: the music library (song_select_screen), then the part,
# the section and the speed, and the song
press down
wait frames=20
press down
wait frames=30
press green
wait frames=60
press green
wait screen=song_select_screen timeout=30s
wait frames=60
# from Random Song to 20th Century Boy, where the cursor stays for the next
# script's music library
press down
wait frames=30
press green
wait screen=part_difficulty_screen timeout=30s
wait frames=90
# Guitar, Expert
press green
wait frames=30
press green
wait screen=practice_sel_section_screen timeout=30s
wait frames=60
capture screen-practice-section
# Full Song
press green
wait screen=practice_sel_speed_screen timeout=30s
wait frames=60
# 100%
press green
wait screen=practice_game_screen timeout=60s
expect song=20thcenturyboy
wait frames=300
capture screen-practice
# its pause menu, an overlay on the same screen
press start
wait frames=30
capture screen-practice-pause
# Back to Music Library, the last of six
press down
press down
press down
press down
press down
wait frames=20
press green
wait screen=song_select_screen timeout=30s
wait frames=60
press red
wait screen=main_hub_screen timeout=30s
wait frames=60
