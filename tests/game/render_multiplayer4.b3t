# Four parts play a song on autoplay, guitar, drums, keys and vocals, pairing
# the game's frame with the native view's (`capture screen-mp4-<kind>`) on the
# screens they bring: the part and difficulty choice with three players'
# panels, the song with four tracks (the vocals' across the top) at points
# through it, its pause menu and the results. The vocals are the USB mics'
# test tone, through Rock Band 3 Deluxe's All Instruments Mode: its karaoke
# vocals need no controller, and add the singer by themselves. Starts where
# boot.b3t leaves Rock Band 3 Deluxe (on a fresh profile); launch with the
# mics and their tone:
#   python tools/band3ctl.py launch --fresh -- --native_view_record_targets=true --test_random_seed=21 --async_shader_compilation=false --usb_mics=true --usb_mic_test_tone=220
#   python tools/band3ctl.py run tests/game/boot.b3t
#   python tools/band3ctl.py run tests/game/render_multiplayer4.b3t
# The fourth part is the singer, not a fourth virtual instrument: with three
# players joined, p4's Start (a guitar, then drums) opened player 1's menu
# instead of joining a fourth.
# Every frame draws everything, as in render_multiplayer.b3t.

# the game has connected mic slot 1 and takes its audio
expect mic=1
# the welcome hint, whose first choice customizes the band; back out of that
# to the main menu
wait screen=hint_rb3_welcome_screen timeout=30s
wait frames=60
press green
wait screen=manage_band_screen timeout=30s
wait frames=60
press red
wait screen=main_hub_screen timeout=30s
wait frames=60
set autoplay true
set forced_venue arena_04
set disable_even_odd_rendering true
set song_speed 1
# players 2 and 3 join, on drums and keys, as guests
p2 instrument drums
wait frames=60
p2 press start
wait frames=120
p3 instrument keys
wait frames=60
p3 press start
wait frames=120
# player 1's menu (Start): Options, All Instruments Mode, Yes; then closed
press start
wait frames=60
press down
wait frames=15
press down
wait frames=15
press down
wait frames=20
press green
wait frames=60
press green
wait frames=90
press up
wait frames=20
press green
wait frames=120
press red
wait frames=40
press red
wait frames=60
# Play Now, Quickplay, Choose Songs
press green
wait frames=90
press green
wait frames=90
press green
wait screen=song_select_screen timeout=30s
wait frames=60
# past the 123 heading to 20th Century Boy
press down
press down
wait frames=30
press green
wait screen=part_difficulty_screen timeout=30s
wait frames=90
capture screen-mp4-part
# player 1: Guitar, Expert; player 2: Drums, its default difficulty
press green
wait frames=30
press green
wait frames=60
p2 press a
wait frames=60
p2 press a
wait frames=60
# player 3: up from Bass (offered first) past Guitar and Pro Keys to Keys,
# its default difficulty; the song starts with the singer added
p3 press up
wait frames=40
p3 press up
wait frames=40
p3 press up
wait frames=40
p3 press a
wait frames=60
p3 press a
wait in_game timeout=60s
expect song=20thcenturyboy
wait screen=game_screen timeout=60s
wait frames=600 timeout=60s
expect mic=1
capture screen-mp4-10s
wait frames=900 timeout=60s
capture screen-mp4-25s
wait frames=900 timeout=60s
capture screen-mp4-40s
# the pause menu, an overlay on the same screen, and on again
press start
wait frames=30
capture screen-mp4-pause
press green
wait frames=120
# the results
wait screen=coop_endgame_screen timeout=300s
wait frames=120
capture screen-mp4-results
