# Plays render_song.b3t's song on autoplay with the live native view on, F7's
# renderer without its window, at 1280x720 on the native_view_backend (the GPU
# by default), and prints its numbers: frames captured and drawn, each drawn
# frame's time (mean, p50, p95, max ms), and the game's own frame rate with the
# view off and then on. Starts where boot.b3t leaves Rock Band 3 Deluxe (on a
# fresh profile), with full readback as render_song.b3t needs:
#   python tools/band3ctl.py launch --fresh -- --readback_resolve=full
#   python tools/band3ctl.py run tests/game/boot.b3t
#   python tools/band3ctl.py run tests/game/render_song_live.b3t
# Add --native_view_record_targets=true to the launch for the texture passes
# too (render_song.b3t says why); `native_view stats` then shows what
# recording them costs while the view is off (rt_recording).
# --test_random_seed=<n> gives the same band every run (render_song.b3t).

# Deluxe can't save its settings to band3's read-only game folder: I Understand
wait screen=dx_settings_error_screen timeout=30s
wait frames=60
press green
# back to the welcome hint underneath it, whose first choice customizes the
# band; back out of that to the main menu
wait screen=hint_rb3_welcome_screen timeout=30s
wait frames=60
press green
wait screen=manage_band_screen timeout=30s
wait frames=60
press red
wait screen=main_hub_screen timeout=30s
wait frames=60
set autoplay true
# the same venue every run, so captures compare across runs
set forced_venue arena_04
# every frame draws everything: otherwise RB3 draws a second camera (the
# arena's video screens) to the back buffer on alternate frames and resolves
# it to a texture, which the native view can't tell from the main view yet
set disable_even_odd_rendering true
# Play Now, Quickplay, Choose Songs
press green
wait frames=60
press green
wait frames=60
press green
wait screen=song_select_screen timeout=30s
wait frames=60
# past the 123 heading to 20th Century Boy
press down
press down
wait frames=30
press green
wait screen=part_difficulty_screen timeout=30s
wait frames=90
# Guitar, Expert
press green
wait frames=30
press green
wait in_game timeout=60s
expect song=20thcenturyboy
# past the song's loading, then 10 s of the game on its own, for its frame
# rate without the native view
wait frames=300 timeout=60s
native_view off
wait frames=600 timeout=60s
native_view stats
# about 40 s with it drawing every frame the game captures
native_view on 1280x720
wait frames=2400 timeout=120s
native_view stats
native_view off
